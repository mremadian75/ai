+                ['THE single dispatch gate: fail-closed allowlist + hard maxTotalChargeUsd + header-only token + security events.']),
+            self::row('apify', 'VES_Run_Execution_Service', 'start_source_apify', 'apify_run_start_core_guarded', true,
