+function sanitize_textarea_field($s){return trim(strip_tags((string)$s));}
+function sanitize_key($s){return strtolower(preg_replace('/[^a-z0-9_\-]/i','',(string)$s));}
+function esc_url_raw($s){return trim((string)$s);}
