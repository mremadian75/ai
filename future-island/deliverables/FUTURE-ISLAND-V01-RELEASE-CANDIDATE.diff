+// ── 4. Allowlisted actor dispatches; token only in Authorization header ─────
+VES_Test_HTTP::reset();
+VES_Test_HTTP::$queue[] = ['code' => 201, 'body' => ['data' => ['id' => 'RUN999', 'status' => 'READY']]];
