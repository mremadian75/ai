+// ── 6. Missing ceiling on a run-start logs a warning diagnostic ─────────────
+VES_Test_HTTP::reset();
+VES_Admin::$diagnostics = [];
+VES_Test_HTTP::$queue[] = ['code' => 201, 'body' => ['data' => ['id' => 'RUN2']]];
