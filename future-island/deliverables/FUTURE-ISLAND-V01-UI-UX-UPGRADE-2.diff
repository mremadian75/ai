+/* Deep-review fix: color-scheme is declared ONLY where the surface is wholly
+ * governed by self-contained styles (Signal Room page, RC page). The member app
+ * (.ves-wrap with fiis-app's literal-color components) and the console (inside
+ * light wp-admin chrome) stay explicitly LIGHT so native controls always match
+ * their rendering — no half-dark patchwork. Member-app dark mode is a roadmap
+ * item pending a literal-color audit of fiis-app.css / ves-frontend.css. */
+.fiis-signal-room,
+.fiis-rc-page { color-scheme: light dark; }
+.ves-wrap,
+.fiis-console { color-scheme: light; }
+.ves-wrap .fiis-signal-room { color-scheme: light dark; } /* the room inside its admin wrap */
+
+/* ── 1b. Skip link — hidden until keyboard focus ──────────────────────────── */
+.ves-wrap .fi-skip-link,
+.fiis-signal-room .fi-skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 0;
