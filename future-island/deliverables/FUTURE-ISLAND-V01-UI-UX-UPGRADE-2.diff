+            $h .= '<span class="fiis-console-status-note">' . self::e('Details: Advanced → Release Candidate. Never production-ready without live evidence.') . '</span>';
+            return $h . '</div>';
+        } catch (\Throwable $e) {
+            self::log($e);
+            return '';
