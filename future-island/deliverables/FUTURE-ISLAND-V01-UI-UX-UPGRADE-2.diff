+            $h .= '<span class="fiis-console-status-item"><span class="fiis-chip-k">' . self::e('AI execution') . '</span>' . $badge($exec_on ? 'warning' : 'disabled', $exec_on ? 'ON' : 'OFF') . '</span>';
