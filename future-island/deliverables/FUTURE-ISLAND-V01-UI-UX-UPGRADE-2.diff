+}
+
+/* ── 1c. Queue next-step hints (honest guidance, never fake data) ─────────── */
+.ves-wrap .fi-queue-hint {
+  display: block;
+  margin-top: 4px;
+  font-family: var(--fi-font-mono);
+  font-size: 11px;
+  color: var(--fi-muted);
+}
+
+/* ── 1d. Console suite-status strip ───────────────────────────────────────── */
+.fiis-console .fiis-console-status {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--fi-space-4);
