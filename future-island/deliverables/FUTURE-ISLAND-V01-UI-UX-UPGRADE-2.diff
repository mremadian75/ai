+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: var(--fi-muted);
+}
+.fiis-console .fiis-console-build {
+  font-family: var(--fi-font-mono);
+  font-size: 12px;
+  color: var(--fi-ink);
+}
+.fiis-console .fiis-console-status-note {
+  flex-basis: 100%;
+  font-size: 11px;
+  color: var(--fi-muted);
+}
+
 /* ── 2. Editorial typography ──────────────────────────────────────────────── */
 .ves-wrap .fi-breadcrumb,
 .ves-wrap .fiis-sr-eyebrow,
@@ -194,6 +272,7 @@
