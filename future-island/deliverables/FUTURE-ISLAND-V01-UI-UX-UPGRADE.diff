diff --git a/future-island/future-island-intelligence-suite/assets/css/fiis-ui-system.css b/future-island/future-island-intelligence-suite/assets/css/fiis-ui-system.css
new file mode 100644
index 0000000..8f2a05a
--- /dev/null
+++ b/future-island/future-island-intelligence-suite/assets/css/fiis-ui-system.css
@@ -0,0 +1,339 @@
+/**
+ * Future Island UI System — unified editorial layer for every operator surface.
+ *
+ * One token source for the FI identity (ink / paper / sand / blue, tactical
+ * lime + red-orange accents, editorial headings, mono metadata) consumed by the
+ * Signal Room, Signal Report, Memory / Brand Context, Prompt Package Preview,
+ * Brief & Draft Workbenches, the Intelligence Suite console and the Release
+ * Candidate page. Strictly additive: scoped under the existing wrappers, no
+ * resets, no generic SaaS widgets, no behavior. Includes dark mode
+ * (prefers-color-scheme), print output for reports/workbenches, and
+ * accessibility affordances (focus-visible, reduced motion, touch targets).
+ */
+
+/* ── 1. Tokens (single source; later sheets in the cascade may refine) ────── */
+.ves-wrap,
+.fiis-console,
+.fiis-signal-room,
+.fiis-rc-page {
+  --fi-ink: #15161a;
+  --fi-paper: #f3efe6;
+  --fi-surface: #fffdf8;
+  --fi-sand: #e7e1d4;
+  --fi-blue: #2f5fd0;
+  --fi-blue-2: #1b2a4a;
+  --fi-lime: #7faa00;
+  --fi-red: #e8552b;
+  --fi-bdr: #d9d2c3;
+  --fi-muted: #5f5d55;            /* AA on paper + surface */
+  --fi-ok: #1f7a4d;
+  --fi-warn: #9a5c00;             /* darkened for AA on paper */
+  --fi-focus: #2f5fd0;
+  --fi-radius: 2px;               /* editorial, not bubbly */
+  --fi-radius-pill: 999px;
+  --fi-shadow: 0 1px 0 rgba(21, 22, 26, 0.06), 0 6px 18px -12px rgba(21, 22, 26, 0.25);
+  --fi-space-1: 4px;  --fi-space-2: 8px;  --fi-space-3: 12px;
+  --fi-space-4: 16px; --fi-space-5: 24px; --fi-space-6: 36px;
+  --fi-font-mono: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
+  --fi-font-edit: Georgia, "Times New Roman", serif;
+}
+
+/* ── 2. Editorial typography ──────────────────────────────────────────────── */
+.ves-wrap .fi-breadcrumb,
+.ves-wrap .fiis-sr-eyebrow,
+.fiis-console .fiis-console-sub,
+.fiis-rc-page .fiis-rc-kicker {
+  font-family: var(--fi-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--fi-blue);
+}
+.ves-wrap .fiis-sr-title,
+.ves-wrap .fi-workbench > h1 {
+  font-size: 34px;
+  line-height: 1.08;
+  font-weight: 800;
+  letter-spacing: -0.01em;
+  color: var(--fi-ink);
+  margin: 2px 0 6px;
+}
+.ves-wrap .fiis-sr-sub {
+  max-width: 64ch;
+  color: var(--fi-muted);
+}
+.ves-wrap .fiis-sr-h2,
+.ves-wrap .fi-workbench h3,
+.ves-wrap .fi-readiness-panel h3,
+.ves-wrap .fi-package-preview h3,
+.ves-wrap .fi-review-rail h3 {
+  font-size: 13px;
+  text-transform: uppercase;
+  letter-spacing: 0.09em;
+  color: var(--fi-blue-2);
+  border-bottom: 1px solid var(--fi-sand);
+  padding-bottom: var(--fi-space-2);
+  margin: var(--fi-space-5) 0 var(--fi-space-3);
+}
+.ves-wrap .fi-meta-line,
+.ves-wrap .fiis-sr-step-count,
+.ves-wrap .fiis-sr-card-v,
+.fiis-rc-page .fiis-rc-meta {
+  font-family: var(--fi-font-mono);
+  font-variant-numeric: tabular-nums;
+}
+.ves-wrap .fi-meta-line { font-size: 12px; color: var(--fi-muted); }
+.ves-wrap .fi-meta-line code,
+.fiis-rc-page .fiis-rc-mono code {
+  background: var(--fi-sand);
+  border: 1px solid var(--fi-bdr);
+  border-radius: var(--fi-radius);
+  padding: 0 4px;
+  color: var(--fi-ink);
+}
+
+/* ── 3. Workflow spine — numbered editorial steps with connectors ─────────── */
+.ves-wrap .fi-workflow-spine ol {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--fi-space-2);
+  list-style: none;
+  margin: var(--fi-space-4) 0;
+  padding: 0;
+  counter-reset: fi-step;
+}
+.ves-wrap .fiis-sr-step {
+  counter-increment: fi-step;
+  display: flex;
+  align-items: baseline;
+  gap: var(--fi-space-2);
+  background: var(--fi-surface);
+  border: 1px solid var(--fi-bdr);
+  border-radius: var(--fi-radius);
+  padding: 6px 12px 6px 8px;
+  position: relative;
+}
+.ves-wrap .fiis-sr-step::before {
+  content: counter(fi-step, decimal-leading-zero);
+  font-family: var(--fi-font-mono);
+  font-size: 10px;
+  color: var(--fi-blue);
+  letter-spacing: 0.08em;
+}
+.ves-wrap .fiis-sr-step:not(:last-child)::after {
+  content: "→";
+  position: absolute;
+  right: -14px;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--fi-muted);
+  font-size: 12px;
+}
+.ves-wrap .fi-workflow-spine ol { column-gap: 20px; }
+.ves-wrap .fiis-sr-step-label {
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  color: var(--fi-ink);
+  text-transform: capitalize;
+}
+.ves-wrap .fiis-sr-step-count {
+  font-size: 12px;
+  color: var(--fi-blue-2);
+  background: var(--fi-sand);
+  border-radius: var(--fi-radius-pill);
+  padding: 0 8px;
+  min-width: 24px;
+  text-align: center;
+}
+
+/* ── 4. Readiness cards ───────────────────────────────────────────────────── */
+.ves-wrap .fiis-sr-cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
+  gap: var(--fi-space-3);
+  margin: var(--fi-space-4) 0 var(--fi-space-5);
+}
+.ves-wrap .fiis-sr-card {
+  background: var(--fi-surface);
+  border: 1px solid var(--fi-bdr);
+  border-radius: var(--fi-radius);
+  padding: var(--fi-space-3) var(--fi-space-4);
+  box-shadow: var(--fi-shadow);
+  transition: transform 120ms ease, box-shadow 120ms ease;
+}
+.ves-wrap .fiis-sr-card:hover { transform: translateY(-1px); }
+.ves-wrap .fiis-sr-card-k {
+  font-family: var(--fi-font-mono);
+  font-size: 10px;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: var(--fi-muted);
+}
+.ves-wrap .fiis-sr-card-v {
+  font-size: 26px;
+  font-weight: 700;
+  color: var(--fi-ink);
+  margin-top: 2px;
+}
+
+/* ── 5. Panels, queues, evidence, callouts ────────────────────────────────── */
+.ves-wrap .fi-readiness-panel,
+.ves-wrap .fi-package-preview,
+.ves-wrap .fi-review-rail,
+.ves-wrap .fi-operator-queue,
+.ves-wrap .fi-evidence-binder {
+  background: var(--fi-surface);
+  border: 1px solid var(--fi-bdr);
+  border-radius: var(--fi-radius);
+  padding: var(--fi-space-4) var(--fi-space-5);
+  margin: 0 0 var(--fi-space-4);
+}
+.ves-wrap .fi-operator-queue ul { margin: 0; padding: 0; list-style: none; }
+.ves-wrap .fi-operator-queue li {
+  border-left: 3px solid var(--fi-sand);
+  padding: var(--fi-space-2) var(--fi-space-3);
+  margin: 0 0 var(--fi-space-2);
+  background: color-mix(in srgb, var(--fi-sand) 35%, transparent);
+}
+.ves-wrap .fi-operator-queue li:hover { border-left-color: var(--fi-blue); }
+.ves-wrap .fi-memory-policy {
+  background: var(--fi-sand);
+  border-left: 4px solid var(--fi-red);
+  border-radius: var(--fi-radius);
+  padding: var(--fi-space-3) var(--fi-space-4);
+  color: var(--fi-ink);
+}
+.ves-wrap .fi-empty-state {
+  border: 1px dashed var(--fi-bdr);
+  border-radius: var(--fi-radius);
+  padding: var(--fi-space-3) var(--fi-space-4);
+  color: var(--fi-muted);
+  background: transparent;
+}
+
+/* ── 6. Review rail — clearly inert until safe handlers exist ─────────────── */
+.ves-wrap .fi-review-rail button[disabled] {
+  background: var(--fi-sand);
+  border: 1px solid var(--fi-bdr);
+  color: var(--fi-muted);
+  border-radius: var(--fi-radius);
+  padding: 6px 14px;
+  cursor: not-allowed;
+  opacity: 0.85;
+}
+
+/* ── 7. Workbench navigation ──────────────────────────────────────────────── */
+.ves-wrap .fi-workbench-nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--fi-space-3);
+  margin: var(--fi-space-2) 0 var(--fi-space-4);
+  font-family: var(--fi-font-mono);
+  font-size: 12px;
+}
+.ves-wrap .fi-workbench-nav a {
+  color: var(--fi-blue);
+  text-decoration: none;
+  border-bottom: 1px solid transparent;
+  padding: 6px 2px; /* comfortable touch target */
+}
+.ves-wrap .fi-workbench-nav a:hover { border-bottom-color: var(--fi-blue); }
+
+/* ── 8. Badges (shared with VES_Review_State) ─────────────────────────────── */
+.ves-wrap .fi-status-badge,
+.fiis-console .fi-status-badge {
+  display: inline-block;
+  font-family: var(--fi-font-mono);
+  font-size: 11px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  padding: 2px 8px;
+  border-radius: var(--fi-radius-pill);
+  border: 1px solid var(--fi-bdr);
+  background: var(--fi-surface);
+  color: var(--fi-ink);
+  white-space: nowrap;
+  vertical-align: middle;
+}
+
+/* ── 9. Accessibility ─────────────────────────────────────────────────────── */
+.ves-wrap a:focus-visible,
+.ves-wrap button:focus-visible,
+.fiis-console a:focus-visible,
+.fiis-rc-page a:focus-visible,
+.fiis-rc-page button:focus-visible,
+.fiis-rc-page summary:focus-visible {
+  outline: 2px solid var(--fi-focus);
+  outline-offset: 2px;
+  border-radius: var(--fi-radius);
+}
+.fi-visually-hidden {
+  position: absolute !important;
+  width: 1px; height: 1px;
+  margin: -1px; padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap; border: 0;
+}
+@media (prefers-reduced-motion: reduce) {
+  .ves-wrap *, .fiis-console *, .fiis-rc-page * {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* ── 10. Dark mode — same identity, inverted paper ────────────────────────── */
+@media (prefers-color-scheme: dark) {
+  .ves-wrap,
+  .fiis-signal-room,
+  .fiis-rc-page {
+    --fi-ink: #ece8dd;
+    --fi-paper: #16171b;
+    --fi-surface: #1d1e24;
+    --fi-sand: #262830;
+    --fi-bdr: #383a44;
+    --fi-muted: #a8a496;
+    --fi-blue: #7d9ff0;
+    --fi-blue-2: #aebfe8;
+    --fi-ok: #4fae7f;
+    --fi-warn: #d9a04a;
+    --fi-red: #f0744e;
+    --fi-lime: #a4cc33;
+    --fi-focus: #7d9ff0;
+    --fi-shadow: 0 1px 0 rgba(0, 0, 0, 0.4), 0 6px 18px -12px rgba(0, 0, 0, 0.8);
+  }
+  .ves-wrap, .fiis-signal-room, .fiis-rc-page { background: var(--fi-paper); color: var(--fi-ink); }
+  .ves-wrap .fi-meta-line code,
+  .fiis-rc-page .fiis-rc-mono code { background: var(--fi-sand); color: var(--fi-ink); }
+  .fiis-rc-page .fiis-rc-section,
+  .fiis-rc-page .fiis-rc-banner,
+  .fiis-rc-page .fiis-rc-table td { background: var(--fi-surface); color: var(--fi-ink); border-color: var(--fi-bdr); }
+  .fiis-rc-page .fiis-rc-table td { background: transparent; }
+  .fiis-rc-page .fi-status-badge { background: var(--fi-surface); color: var(--fi-ink); border-color: var(--fi-bdr); }
+}
+
+/* ── 11. Print — reports and workbenches as clean paper documents ─────────── */
+@media print {
+  .ves-wrap, .fiis-rc-page { background: #fff !important; color: #000 !important; }
+  .ves-wrap .fi-review-rail,
+  .ves-wrap .fi-workbench-nav,
+  .fiis-rc-page .fiis-rc-copy,
+  #adminmenumain, #wpadminbar, #wpfooter { display: none !important; }
+  .ves-wrap .fi-readiness-panel,
+  .ves-wrap .fi-package-preview,
+  .ves-wrap .fi-evidence-binder,
+  .fiis-rc-page .fiis-rc-section { break-inside: avoid; border: 1px solid #999; box-shadow: none; }
+  .ves-wrap a, .fiis-rc-page a { color: #000; text-decoration: underline; }
+}
+
+/* ── 12. Small screens ────────────────────────────────────────────────────── */
+@media (max-width: 782px) {
+  .ves-wrap .fiis-sr-title, .ves-wrap .fi-workbench > h1 { font-size: 26px; }
+  .ves-wrap .fiis-sr-step:not(:last-child)::after { content: none; }
+  .ves-wrap .fi-workflow-spine ol { column-gap: var(--fi-space-2); }
+  .ves-wrap .fi-readiness-panel,
+  .ves-wrap .fi-package-preview,
+  .ves-wrap .fi-operator-queue { padding: var(--fi-space-3); }
+}
