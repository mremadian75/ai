+                $reused = $event_id > 0;
+            }
+        }
+        if ($event_id <= 0 && class_exists('VES_AI_Usage_Tracker') && method_exists('VES_AI_Usage_Tracker', 'record')) {
+            $event_id = (int) VES_AI_Usage_Tracker::record([
